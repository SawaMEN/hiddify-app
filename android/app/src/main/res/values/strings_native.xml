    <string name="native_wifi_guide_open">How to connect devices</string>
    <string name="native_wifi_guide_title">Connect to this phone Wi-Fi</string>
    <string name="native_wifi_guide_receiver_title">Receiving device</string>
    <string name="native_wifi_guide_receiver_text">This Android phone runs VetrOFF and shares access through its Wi-Fi hotspot. Choose the operating system of the device receiving Wi-Fi. The steps below are for that receiving device, not for this phone.</string>
    <string name="native_wifi_guide_root_note">Root mode is active on this phone. The receiving device should not use a manual proxy.</string>
    <string name="native_wifi_guide_details">Proxy connection details</string>
    <string name="native_wifi_guide_host">Phone / gateway IP</string>
    <string name="native_wifi_guide_gateway_fallback">Wi-Fi gateway of the receiving device</string>
    <string name="native_wifi_guide_port">Port</string>
    <string name="native_wifi_guide_username">Username</string>
    <string name="native_wifi_guide_password">Proxy password</string>
    <string name="native_wifi_guide_password_missing">Enable sharing to create a password</string>
    <string name="native_wifi_guide_refresh_ip">Refresh phone IP</string>
    <string name="native_wifi_platform_android">Android</string>
    <string name="native_wifi_platform_windows">Windows</string>
    <string name="native_wifi_platform_linux">Linux</string>
    <string name="native_wifi_platform_macos">macOS</string>
    <string name="native_wifi_platform_ios">iPhone / iPad</string>
    <string name="native_wifi_guide_step_connect">Join the phone hotspot</string>
    <string name="native_wifi_guide_connect_text">On the receiving device, connect to the Wi-Fi hotspot created by this phone and enter the hotspot password. Keep mobile data or another internet connection active on the phone that runs VetrOFF.</string>
    <string name="native_wifi_guide_step_proxy">Configure the manual proxy</string>
    <string name="native_wifi_guide_step_no_proxy">Keep the client proxy disabled</string>
    <string name="native_wifi_guide_proxy_text">Use the phone local IP shown above. Do not enter the remote VPN server address. HTTP and compatible proxy-aware applications can use these settings; applications that ignore the system proxy may connect directly.</string>
    <string name="native_wifi_guide_root_client_text">Because this phone is using root interception, leave the receiving device proxy set to None / Off. Connect to the hotspot normally and let the phone route client traffic through the VPN.</string>
    <string name="native_wifi_guide_proxy_field">Proxy</string>
    <string name="native_wifi_guide_server_field">Server / host</string>
    <string name="native_wifi_guide_auth_field">Authentication</string>
    <string name="native_wifi_guide_proxy_manual">Manual</string>
    <string name="native_wifi_guide_proxy_off">None / Off</string>
    <string name="native_wifi_guide_illustration_note">Simplified settings diagram — menu names can differ by OS version.</string>
    <string name="native_wifi_path_android">Wi-Fi → connected network → Edit → Advanced → Proxy</string>
    <string name="native_wifi_path_windows">Settings → Network &amp; internet → Proxy → Manual proxy</string>
    <string name="native_wifi_path_linux">Settings → Network → Network Proxy → Manual</string>
    <string name="native_wifi_path_macos">System Settings → Network → Wi-Fi → Details → Proxies</string>
    <string name="native_wifi_path_ios">Settings → Wi-Fi → ⓘ → Configure Proxy → Manual</string>
    <string name="native_wifi_auth_browser">Browser / proxy client</string>
    <string name="native_wifi_auth_app">Application prompt</string>
    <string name="native_wifi_auth_on">On</string>
    <string name="native_wifi_auth_note_android">Android Wi-Fi settings usually do not provide username/password fields. If the browser does not request credentials, use an application with authenticated HTTP/SOCKS proxy support.</string>
    <string name="native_wifi_auth_note_windows">Windows system proxy has limited credential handling. Enter hiddify and the proxy password when the browser or application asks, or configure an authenticated proxy directly in that application.</string>
    <string name="native_wifi_auth_note_linux">Desktop environments differ. If the system proxy has no credentials fields, set the authenticated HTTP/SOCKS proxy in the browser or application that should use the VPN.</string>
    <string name="native_wifi_auth_note_macos">Enable proxy authentication when available and use username hiddify plus the password shown above.</string>
    <string name="native_wifi_auth_note_ios">Turn Authentication on and use username hiddify plus the password shown above.</string>
    <string name="native_wifi_guide_step_verify">Verify routing</string>
    <string name="native_wifi_guide_verify_text">Open an external IP test on this phone and on the receiving device. For traffic routed through the VPN, the public IP should match. Also test DNS and each application you need because a manual proxy does not capture every protocol.</string>
    <string name="native_wifi_guide_step_troubleshoot">Troubleshooting</string>
    <string name="native_wifi_guide_troubleshoot_proxy">If the connection times out, confirm the receiving device is still on this phone Wi-Fi, refresh the phone IP, check the port and credentials, and reconnect the VPN after changing sharing settings. HTTP 407 means proxy authentication failed.</string>
    <string name="native_wifi_guide_troubleshoot_root">If traffic bypasses the VPN, verify root permission on this phone, reconnect the VPN and retry. If root interception is not supported by the device kernel or firmware, disable root mode and use the authenticated proxy method instead.</string>
    <string name="native_wifi_guide_step_finish">Finish sharing</string>
    <string name="native_wifi_guide_finish_proxy">Disconnect from the phone Wi-Fi and restore Proxy to None / Off on the receiving device. A saved phone IP can prevent internet access on another Wi-Fi network later.</string>
    <string name="native_wifi_guide_finish_root">Disconnect from the phone hotspot when finished. No proxy cleanup is required because the receiving device was left on None / Off.</string>


